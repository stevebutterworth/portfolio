<% content_for :title, "Steve Butterworth · Product Engineer · Tech Lead" %>
<% content_for :description, "Product engineer and tech lead with over 20 years turning raw, live data into products people use. Product-focused and test-first." %>

<section class="grid grid-cols-1 items-end border-b border-line md:grid-cols-2">
  <div class="px-5 pb-8 pt-12 md:px-10 md:pb-12 md:pt-16">
    <div class="text-[11px] font-semibold uppercase tracking-widest text-accent-d">Product Engineer · Tech Lead</div>
    <h1 class="mt-3.5 max-w-[22ch] text-4xl font-medium leading-[1.06] tracking-tight md:text-[50px] md:leading-[1.03]">I turn raw, live data into products people use every day.</h1>
  </div>
  <div class="px-5 pb-10 md:px-10 md:pb-12 md:pt-16">
    <p class="max-w-[46ch] font-body text-base leading-relaxed text-ink2">Tech lead, product-focused and test-first, with over 20 years of whole-product ownership. Live shot tracking for The Open built from GPS and scoring feeds, serving over a million visits a day. Thirteen years behind the UK&rsquo;s leading environmental jobs site, whose search alerts have sent millions of emails. LLM pipelines that classify website changes for Am Law 200 firms.</p>
  </div>
</section>

<div class="flex items-baseline justify-between px-5 pb-1 pt-8 md:px-10">
  <span class="text-xs font-semibold uppercase tracking-widest text-accent-d">Selected work</span>
  <span class="text-xs font-semibold uppercase tracking-widest text-muted"><%= format("%02d", @projects.size) %> projects</span>
</div>

<% @projects.each_with_index do |project, index| %>
  <%= render "project", project: project, index: index %>
<% end %>

<section class="border-t border-line px-5 py-9 md:px-10 md:py-11">
  <div class="grid grid-cols-1 gap-6 md:grid-cols-[330px_1fr]">
    <div>
      <span class="text-xs font-semibold uppercase tracking-widest text-accent-d">Also delivered projects for</span>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2 text-xs font-semibold uppercase tracking-widest text-ink2 md:justify-end md:pt-1">
      <% [ "British Airways", "St Modwen", "Lenovo", "Cambridge University Press" ].each do |name| %>
        <span><%= name %></span>
        <span class="last:hidden text-accent-d/50">/</span>
      <% end %>
    </div>
  </div>
</section>
